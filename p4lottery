#!/bin/bash
# 🚀 p4lottery (Prediction Engine 4 Lottery) Unified Launcher
# This script handles environment activation, project setup, and subcommands.

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$PROJECT_ROOT/.venv"
export PYTHONPATH="$PROJECT_ROOT"

# Setup Check
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment for p4lottery..."
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --upgrade pip
    if [ -f "$PROJECT_ROOT/pyproject.toml" ]; then
        "$VENV_DIR/bin/pip" install -e .
    fi
fi

# Execution
if [ $# -eq 0 ]; then
    echo "=================================================="
    echo "🎯 p4lottery — Prediction Engine 4 Lottery"
    echo "=================================================="
    echo "Golden Path: Use './p4lottery wizard' to start interactive analysis."
    echo "Interactive Lab: Open 'docs/reference/frontier-synthesis-lab.html'"
    echo ""
    "$VENV_DIR/bin/python3" -m engine.cli.main --help
else
    "$VENV_DIR/bin/python3" -m engine.cli.main "$@"
fi
